# Environment variables — copy to server/.env and fill in real values
# Never commit server/.env to git

# Gemini Cloud AI (used in P06)
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam Translation API (used in P09)
SARVAM_API_KEY=your_sarvam_api_key_here

# Bearer token for the local proxy (generated on first run in P06)
PROXY_BEARER_TOKEN=change_me_to_a_random_secret

# Local llama-server endpoint (default; override if using a different port)
LLAMA_SERVER_URL=http://localhost:11434
