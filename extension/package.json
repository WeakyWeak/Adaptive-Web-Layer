{
  "name": "awl-extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx vite build --watch & npx vite build --config vite.content.config.ts --watch",
    "build": "npx vite build && npx vite build --config vite.content.config.ts",
    "typecheck": "npx tsc --noEmit",
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "lint": "npx eslint src --ext .ts,.tsx",
    "e2e": "npx playwright test",
    "eval:planner": "npx vite-node scripts/evalPlanner.ts --",
    "eval:comprehension": "npx vite-node scripts/evalComprehension.ts --",
    "eval:supervisor": "npx vite-node scripts/evalSupervisor.ts --",
    "eval:describe": "npx vite-node scripts/evalDescribe.ts --"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@types/chrome": "^0.0.270",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.12.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.2"
  }
}
