# Copy to server/.env. These are read only by the localhost proxy.
GEMINI_API_KEY=replace_with_your_gemini_key
ANTHROPIC_API_KEY=replace_with_your_anthropic_key
# Claude effort for planning requests: low (fastest) | medium | high | xhigh | max
ANTHROPIC_EFFORT=low
SARVAM_API_KEY=replace_with_your_sarvam_key
# Optional: any OpenAI-compatible chat-completions API as a cloud backend or reviewer
# (e.g. https://openrouter.ai/api/v1). Pick it in Settings → AI → Cloud backend.
OPENAI_COMPAT_BASE_URL=replace_with_an_openai_compatible_base_url
OPENAI_COMPAT_API_KEY=replace_with_its_key
OPENAI_COMPAT_MODEL=replace_with_a_model_id
PROXY_TOKEN=replace_with_a_long_random_local_token
PORT=8787
# Optional. By default any chrome-extension:// origin is accepted (web pages never are).
# To pin your extension id(s), comma-separated:
# ALLOWED_ORIGIN=chrome-extension://abcdefghijklmnopabcdefghijklmnop
